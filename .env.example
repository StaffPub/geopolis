# ─────────────────────────────────────────────
# GEOPOLIS — Variables d'environnement
# Copier vers .env (jamais de secrets en dur dans le code)
# ─────────────────────────────────────────────

# ── Stockage Upstash Redis (production recommandée) ──
# Dashboard Upstash → Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sécurité ──
# Secret utilisé pour hasher les tokens de session avant stockage.
# Obligatoire en production (longue chaîne aléatoire).
SESSION_SECRET=

# ── Administrateur ──
# L'email EXACT (normalisé en minuscules) qui reçoit le rôle admin.
# Vérifié côté serveur sur CHAQUE route sensible — jamais dans le navigateur.
ADMIN_EMAIL=

# ── Runtime ──
NODE_ENV=production
PORT=10000

# ── Simulation ──
# Le moteur tourne côté serveur ; un seul leader par cluster (lock distribué).
SIMULATION_ENABLED=true
# 1 tick = 1 jour de jeu (ms réels). 600000 = 10 MINUTES réelles par jour de
# jeu : progression lente et réfléchie (monde persistant qui tourne 24h/24).
# En PRODUCTION un plancher de 10 minutes est imposé (même si une ancienne
# variable du dashboard vaut 20000) ; échappement expérimental :
# TICK_MS_FORCE=true
TICK_MS=600000
# Sauvegarde complète des pays toutes les N ticks (entre-temps : sauvegarde
# légère). Monte à 12 pour encore moins de bande passante Upstash.
PERSIST_EVERY_TICKS=6

# ── Facultatif ──
# APP_URL=https://geopolis.onrender.com
# DATA_DIR=./data          # répertoire du stockage fichier (fallback local)
# LOG_LEVEL=info           # debug | info | warn | error
